# Copy to .env and fill in. The Ansible playbook creates this file for you with
# random secrets, so you normally only set the domain, email and password.
# Never commit .env.

# Your Pi's Tailscale name (Tailscale admin console > Machines). HTTPS is served here.
PIVAULT_DOMAIN=pivault.your-tailnet.ts.net

# The first account, created the first time the server starts.
PIVAULT_ADMIN_EMAIL=you@example.com
PIVAULT_ADMIN_PASSWORD=change-this-to-a-long-password

# Random secrets. Generate each with:  openssl rand -hex 32
PIVAULT_SECRET_KEY=
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Where things live on the Pi.
PIVAULT_STORAGE_DIR=/mnt/storage/pivault
PIVAULT_POSTGRES_DIR=/mnt/disk1/postgres

# Optional. Largest single upload in bytes (default 10 GB) and days kept in the trash.
# PIVAULT_MAX_UPLOAD_BYTES=10737418240
# PIVAULT_TRASH_DAYS=30

# Optional. Use images built by GitHub Actions instead of building on the Pi.
# PIVAULT_BACKEND_IMAGE=ghcr.io/<your-github-user>/pivault-backend:latest
# PIVAULT_WEB_IMAGE=ghcr.io/<your-github-user>/pivault-web:latest
