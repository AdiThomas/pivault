# Settings baked into the PiVault SD-card image.
# Copy to config.env (same folder) and edit. config.env is never committed.
# Lines are KEY=value with no spaces around the = sign.

# Name of the Pi on your network (reachable as pivault.local at home).
PI_HOSTNAME=pivault
PI_TIMEZONE=America/Toronto

# Wi-Fi (optional). Leave WIFI_SSID empty to use Ethernet only, which is the more
# reliable choice for a server. With both, Ethernet is preferred when plugged in.
WIFI_SSID=
WIFI_PASSWORD=
# Two-letter country code; Wi-Fi stays off until one is set.
WIFI_COUNTRY=CA

# The first PiVault account (what you type into the app).
# Leave the password empty to have a random one generated; it is written to
# infra/image/build/credentials.txt on this computer.
PIVAULT_ADMIN_EMAIL=you@example.com
PIVAULT_ADMIN_PASSWORD=

# Console password for the "pi" user on the Pi itself (keyboard and screen). SSH uses
# your key, not this password. Empty = random, saved in credentials.txt.
PI_PASSWORD=

# Optional: a Tailscale auth key (tskey-auth-...) so the Pi joins your tailnet by
# itself. Create one at https://login.tailscale.com/admin/settings/keys
# Without it, run `sudo tailscale up` on the Pi once after it boots.
TAILSCALE_AUTHKEY=

# Also serve plain HTTP on the home network (http://pivault.local) for a first test.
ALLOW_LAN_HTTP=false
