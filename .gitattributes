# Shell scripts and container files must keep Unix line endings, even on Windows.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.j2 text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.timer text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
*.png binary
*.jpg binary
*.webp binary
*.xz binary
*.img binary
